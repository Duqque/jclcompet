# Racine publique : seul ce dossier doit être servi par Apache.
Options -Indexes -MultiViews
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Transmettre l'en-tête Authorization (jeton de l'application) à PHP, y compris en CGI / FastCGI.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    # Fichiers et dossiers réels (assets) servis directement
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Aucun script PHP exécutable dans les téléversements publics
<IfModule mod_headers.c>
    <FilesMatch "\.(woff2|png|jpe?g|svg|webp|css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
