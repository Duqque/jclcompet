# JCL Compét — configuration. Copier en .env (jamais versionné) puis renseigner.
APP_NAME="JCL Compét"
# local | demo | production
APP_ENV=production
APP_DEBUG=false
# Adresse publique, sans barre finale (ex. https://compet.jcleforest.fr)
APP_URL=https://exemple.fr
# Sous-dossier si l'application n'est pas à la racine du domaine (ex. /compet), sinon vide
APP_BASE_PATH=
APP_TIMEZONE=Europe/Paris

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

SESSION_NAME=jclc_session
# Durée d'inactivité avant déconnexion (secondes) — 12 h couvre une journée de compétition
SESSION_LIFETIME=43200
# true en HTTPS (obligatoire en production)
FORCE_SECURE_COOKIES=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Secret de chaînage du journal d'audit : chaîne aléatoire longue (php -r "echo bin2hex(random_bytes(32));")
AUDIT_SECRET=
# Validité par défaut d'un lien d'affichage TV (jours)
TV_TOKEN_DAYS=7
UPLOAD_MAX_BYTES=8388608

ORGANIZER_NAME="JC Leforest"
ORGANIZER_LOGO=img/logo-jcl.png
